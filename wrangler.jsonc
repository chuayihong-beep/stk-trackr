{
  // Serves the built React app as static assets on Cloudflare Workers.
  // "name" must match the Worker name in the Cloudflare dashboard.
  "name": "stk-trackr",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
